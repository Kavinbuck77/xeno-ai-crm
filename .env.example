# Gemini AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Database Configuration (for Production PostgreSQL profile)
DB_URL=jdbc:postgresql://localhost:5432/xenocrm
DB_USERNAME=postgres
DB_PASSWORD=your_db_password_here

# Services Configuration
CRM_SERVICE_URL=http://localhost:8080
CHANNEL_SERVICE_URL=http://localhost:8081

# Frontend Configuration (for xeno-crm-frontend/.env)
VITE_API_URL=http://localhost:8080
